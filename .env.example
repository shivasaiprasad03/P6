# Server configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Google Gemini API key for live GenAI plan generation and chat.
# Without this key, AirShield AI automatically runs its deterministic local
# intelligence engine so every feature remains functional offline and in demos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Set to "true" to disable external Open-Meteo network calls and use built-in winter smog fixtures
OFFLINE_MODE=false
